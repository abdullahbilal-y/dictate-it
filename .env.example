# Copy to .env (git-ignored). Optional: without a key DictateIt runs rules-only, fully offline.
# Free key: https://openrouter.ai/keys  (free models: 50 requests/day, 1000/day after $10 lifetime credit)
OPENROUTER_API_KEY=
# Free key: https://console.groq.com/keys  (Whisper large-v3 speech: 2,000 requests/day; chat: 1,000/day per model)
GROQ_API_KEY=
